pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'ghcr.io/kealabs-ai'
        PROJECT_NAME = 'labsbusinessintelligence'
        BACKEND_IMAGE = "${DOCKER_REGISTRY}/${PROJECT_NAME}-backend"
        FRONTEND_IMAGE = "${DOCKER_REGISTRY}/${PROJECT_NAME}-frontend"
        MYSQL_IMAGE = "mysql:8.0"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git submodule update --init --recursive'
            }
        }
        
        stage('Environment Setup') {
            steps {
                script {
                    sh '''
                        # Copy environment files
                        cp backend/.env.example backend/.env
                        cp frontend/.env.example frontend/.env
                        
                        # Create backup directory
                        mkdir -p backups
                    '''
                }
            }
        }
        
        stage('Build Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        script {
                            dir('backend') {
                                def backendImage = docker.build("${BACKEND_IMAGE}:${BUILD_NUMBER}")
                                backendImage.push()
                                backendImage.push("latest")
                            }
                        }
                    }
                }
                stage('Build Frontend') {
                    steps {
                        script {
                            dir('frontend') {
                                def frontendImage = docker.build("${FRONTEND_IMAGE}:${BUILD_NUMBER}")
                                frontendImage.push()
                                frontendImage.push("latest")
                            }
                        }
                    }
                }
            }
        }
        
        stage('Database Setup') {
            steps {
                script {
                    sh '''
                        # Start MySQL container for testing
                        docker run -d --name mysql-test \
                            -e MYSQL_ROOT_PASSWORD=password \
                            -e MYSQL_DATABASE=labsbi_test \
                            -p 3307:3306 \
                            -v $(pwd)/devops/sql/init.sql:/docker-entrypoint-initdb.d/init.sql \
                            mysql:8.0
                        
                        # Wait for MySQL to be ready
                        sleep 30
                    '''
                }
            }
        }
        
        stage('Test') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        script {
                            sh '''
                                # Backend API tests
                                docker run --rm --link mysql-test:mysql \
                                    -e DB_ENGINE=mysql \
                                    -e MYSQL_HOST=mysql \
                                    -e MYSQL_USER=root \
                                    -e MYSQL_PASSWORD=password \
                                    -e MYSQL_DATABASE=labsbi_test \
                                    ${BACKEND_IMAGE}:${BUILD_NUMBER} \
                                    python -c "import requests; print('Backend OK')" || true
                            '''
                        }
                    }
                }
                stage('Frontend Tests') {
                    steps {
                        script {
                            sh '''
                                # Frontend build test
                                docker run --rm ${FRONTEND_IMAGE}:${BUILD_NUMBER} \
                                    npm run build || true
                            '''
                        }
                    }
                }
                stage('Integration Tests') {
                    steps {
                        script {
                            sh '''
                                # Test API endpoints
                                curl -f http://localhost:6002/ || echo "API test skipped"
                                
                                # Test database connection
                                docker exec mysql-test mysql -u root -ppassword -e "SELECT 1" || echo "DB test skipped"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    sh '''
                        # Scan for secrets
                        grep -r "password\|secret\|key" --exclude-dir=.git --exclude="*.md" . || echo "Security scan completed"
                        
                        # Docker image security scan
                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image ${BACKEND_IMAGE}:${BUILD_NUMBER} || echo "Security scan completed"
                    '''
                }
            }
        }
        
        stage('Deploy to DEV') {
            steps {
                script {
                    sh '''
                        # Deploy to development environment
                        docker-compose -f devops/environments/dev/docker-compose.yml down || true
                        docker-compose -f devops/environments/dev/docker-compose.yml up -d
                        
                        # Health check
                        sleep 10
                        curl -f http://localhost:6002/ || echo "DEV deployment health check failed"
                    '''
                }
            }
        }
        
        stage('Deploy to HML') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    sh '''
                        # Backup database before deployment
                        docker exec labsbi_mysql mysqldump -u root -ppassword labsbi > backups/hml_backup_${BUILD_NUMBER}.sql || true
                        
                        # Deploy to homologation
                        docker-compose -f devops/environments/hml/docker-compose.yml down || true
                        docker-compose -f devops/environments/hml/docker-compose.yml up -d
                        
                        # Health check
                        sleep 15
                        curl -f http://localhost:6001/ || echo "HML deployment health check failed"
                    '''
                }
            }
        }
        
        stage('Deploy to PROD') {
            when {
                branch 'master'
            }
            steps {
                input message: 'Deploy to production?', ok: 'Deploy'
                script {
                    sh '''
                        # Backup production database
                        docker exec labsbi_mysql mysqldump -u root -ppassword labsbi > backups/prod_backup_${BUILD_NUMBER}.sql || true
                        
                        # Deploy to production
                        docker-compose -f devops/environments/prod/docker-compose.yml down || true
                        docker-compose -f devops/environments/prod/docker-compose.yml up -d
                        
                        # Health check
                        sleep 20
                        curl -f http://localhost:6000/ || echo "PROD deployment health check failed"
                        
                        # Notify deployment
                        echo "🚀 LabsBusinessIntelligence deployed to PRODUCTION successfully!"
                    '''
                }
            }
        }
    }
    
    post {
        always {
            script {
                sh '''
                    # Cleanup test containers
                    docker stop mysql-test || true
                    docker rm mysql-test || true
                    
                    # Archive logs
                    docker-compose logs > build_logs_${BUILD_NUMBER}.log || true
                '''
            }
            archiveArtifacts artifacts: '*.log, backups/*.sql', allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo '✅ Pipeline executado com sucesso!'
            script {
                sh 'echo "Build ${BUILD_NUMBER} completed successfully at $(date)"'
            }
        }
        failure {
            echo '❌ Pipeline falhou!'
            script {
                sh 'echo "Build ${BUILD_NUMBER} failed at $(date)"'
            }
        }
    }
}